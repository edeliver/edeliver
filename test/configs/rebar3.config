{deps, [{ranch, "1.8.1", {git, "https://github.com/ninenines/ranch", {tag, "1.8.1"}}},
        {edeliver, "v1.10.0", {git, "https://github.com/edeliver/edeliver", {tag, "v1.10.0"}}}
       ]}.
{erl_opts, [debug_info]}.

{relx, [{release, { eco, "0.1.0" }, [
          eco,
          edeliver,
          sasl
        ]},

        {sys_config, "./config/sys.config"},
        {vm_args_src, "./config/vm.args.src"},

        {dev_mode, true},
        {include_erts, false},
        {extended_start_script, true}]
}.

{profiles, [{prod, [{relx, [{dev_mode, false},
                            {include_erts, true}]}]
            }]
}.